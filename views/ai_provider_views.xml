<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_tree" model="ir.ui.view">
        <field name="name">ai.provider.tree</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="name"/>
                <field name="protocol_type"/>
                <field name="ai_role"/>
                <field name="model_name"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <widget name="web_ribbon" title="Active" bg_color="bg-success" invisible="not is_active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Qwen Local"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ai_role"/>
                            <field name="protocol_type"/>
                            <field name="model_name"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="api_base_url" placeholder="http://localhost:11434/v1"/>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
