<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="AI Assistant" data-key="ai_assistant">
                    <h2>AI Permissions</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" groups="base.group_no_one">
                            <div class="o_setting_left_pane">
                                <field name="ai_enable_create_tools"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ai_enable_create_tools" string="Enable AI Create Actions"/>
                                <div class="text-muted">Allow AI to create new records in Odoo.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" groups="base.group_no_one">
                            <div class="o_setting_left_pane">
                                <field name="ai_enable_update_tools"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ai_enable_update_tools" string="Enable AI Update Actions"/>
                                <div class="text-muted">Allow AI to update existing records in Odoo.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" groups="base.group_no_one">
                            <div class="o_setting_left_pane">
                                <field name="ai_enable_delete_tools"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ai_enable_delete_tools" string="Enable AI Delete Actions"/>
                                <div class="text-muted">Allow AI to delete records in Odoo.</div>
                            </div>
                        </div>
                    </div>

                    <h2>AI Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ai_max_history_messages" string="Max History Messages"/>
                                <div class="text-muted">Number of previous messages to remember.</div>
                                <div class="content-group">
                                    <field name="ai_max_history_messages"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ai_max_tool_turns" string="Max Tool Execution Turns"/>
                                <div class="text-muted">Maximum consecutive tool calls per request.</div>
                                <div class="content-group">
                                    <field name="ai_max_tool_turns"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ai_write_keywords" string="Write Action Keywords"/>
                                <div class="text-muted">Comma-separated keywords to trigger the Write AI Provider.</div>
                                <div class="content-group">
                                    <field name="ai_write_keywords"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ai_custom_system_prompt" string="Custom System Prompt"/>
                                <div class="text-muted">Additional instructions for the system prompt.</div>
                                <div class="content-group">
                                    <field name="ai_custom_system_prompt"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ai_chat_ui_mode" string="Chat Interface Mode"/>
                                <div class="text-muted">Choose: Odoo Discuss, Chat UI, or Both.</div>
                                <div class="content-group">
                                    <field name="ai_chat_ui_mode" widget="radio"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_ai_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'ai_assistant', 'bin_size': False}</field>
    </record>
</odoo>
