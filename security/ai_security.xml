<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AI Chat Thread: Regular Users see only their own threads -->
        <record id="ai_chat_thread_user_rule" model="ir.rule">
            <field name="name">AI Chat Thread: User Own Threads</field>
            <field name="model_id" ref="model_ai_chat_thread"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- AI Chat Thread: System Admins have full access -->
        <record id="ai_chat_thread_admin_rule" model="ir.rule">
            <field name="name">AI Chat Thread: Admin Full Access</field>
            <field name="model_id" ref="model_ai_chat_thread"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- AI Chat Message: Regular Users see only messages in their own threads -->
        <record id="ai_chat_message_user_rule" model="ir.rule">
            <field name="name">AI Chat Message: User Own Messages</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[('thread_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- AI Chat Message: System Admins have full access -->
        <record id="ai_chat_message_admin_rule" model="ir.rule">
            <field name="name">AI Chat Message: Admin Full Access</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
